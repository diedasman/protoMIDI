#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/* protoMIDI v1.0 custom PCB: 3x4 col2row matrix, two EC11 encoders. */

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        debounce-press-ms = <0>;
        debounce-release-ms = <5>;
        wakeup-source;

        col-gpios
            = <&gpio0 2 GPIO_ACTIVE_HIGH>
            , <&gpio1 11 GPIO_ACTIVE_HIGH>
            , <&gpio0 29 GPIO_ACTIVE_HIGH>
            , <&gpio0 31 GPIO_ACTIVE_HIGH>;

        row-gpios
            = <&gpio1 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
    };

    default_transform: keymap_transform {
        compatible = "zmk,matrix-transform";
        columns = <4>;
        rows = <3>;
        map = <
        // ENC1 switch     ENC2 switch
            RC(0,0)        RC(0,2)
        // SW1             SW2             SW3             SW4
            RC(1,0)        RC(1,1)        RC(1,2)        RC(1,3)
        // SW5             SW6             SW7             SW8
            RC(2,0)        RC(2,1)        RC(2,2)        RC(2,3)
        >;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "protoMIDI";
        kscan = <&kscan0>;
        transform = <&default_transform>;
        keys
            = <&key_physical_attrs 100 100  50   0 0 0 0>
            , <&key_physical_attrs 100 100 250   0 0 0 0>
            , <&key_physical_attrs 100 100   0 125 0 0 0>
            , <&key_physical_attrs 100 100 100 125 0 0 0>
            , <&key_physical_attrs 100 100 200 125 0 0 0>
            , <&key_physical_attrs 100 100 300 125 0 0 0>
            , <&key_physical_attrs 100 100   0 225 0 0 0>
            , <&key_physical_attrs 100 100 100 225 0 0 0>
            , <&key_physical_attrs 100 100 200 225 0 0 0>
            , <&key_physical_attrs 100 100 300 225 0 0 0>
            ;
    };

    encoder1: encoder_1 {
        compatible = "alps,ec11";
        a-gpios = <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "okay";
    };

    encoder2: encoder_2 {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder1 &encoder2>;
        triggers-per-rotation = <20>;
    };
};

/* Each illuminated PB86 LED is wired GPIO -> resistor -> LED -> ground. */
/ {
    leds {
        compatible = "gpio-leds";

        led1: led_1 { gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>; };
        led2: led_2 { gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>; };
        led3: led_3 { gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>; };
        led4: led_4 { gpios = <&gpio0 24 GPIO_ACTIVE_HIGH>; };
        led5: led_5 { gpios = <&gpio1 0 GPIO_ACTIVE_HIGH>; };
        led6: led_6 { gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>; };
        led7: led_7 { gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>; };
        led8: led_8 { gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>; };
    };
};
